# Rust build output
/target/
**/*.rs.bk

# Local SDD tooling cache (regenerated by `gentle-ai skill-registry refresh`)
/.atl/

# Editors and OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Packaging output
/dist/
*.msi
*.dmg
*.deb
*.rpm
*.tar.gz

# Local secrets and environment
.env
.env.*
*.pem
*.key

# Locally generated audio (see assets/musics/LICENSE.md, D-10)
assets/musics/*
!assets/musics/LICENSE.md
!assets/musics/README.md

# cargo-mutants output (use -o <scratchpad> instead)
/mutants.out/
/mutants.out.old/

# Playwright MCP tool output (not project files)
/.playwright-mcp/

# Technical manual build output (generated PDF is not committed)
docs/manuals/tecnico/build/
