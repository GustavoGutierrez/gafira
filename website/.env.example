# Copy to .env (untracked) and fill in. Never commit values.
CLOUDFLARE_ACCOUNT_ID=
# Optional, instead of `wrangler login`. Needs "Workers Scripts: Edit" on the
# account and "Workers Routes: Edit" and "DNS: Edit" on the gafira.com zone.
CLOUDFLARE_API_TOKEN=
# Optional: a GitHub token for the build-time release lookup (higher rate limit).
GITHUB_TOKEN=
