---
// One page for both languages: Workers serves it for every missing path.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy } from '../i18n/ui';

const es = copy.es.notFound;
const en = copy.en.notFound;
---

<Base locale="es" title={`${es.title} · Gafira`} alternate={false} noindex>
  <Header locale="es" />
  <main id="main" class="missing">
    <div class="container">
      <p class="missing__code">404</p>
      <h1>{es.title}</h1>
      <p>{es.text}</p>
      <a class="button button--primary" href="/">{es.home}</a>
      <div class="missing__other" lang="en">
        <h2>{en.title}</h2>
        <p>{en.text}</p>
        <a class="button button--outline" href="/en/">{en.home}</a>
      </div>
    </div>
  </main>
  <Footer locale="es" />
</Base>

<style>
  .missing {
    padding-block: clamp(72px, 12vw, 144px);
    text-align: center;
  }

  .missing__code {
    font-family: var(--font-head);
    font-size: clamp(72px, 14vw, 140px);
    line-height: 1;
    font-weight: 800;
    color: var(--coral);
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.2;
  }

  p {
    margin: 12px auto 28px;
    max-width: 520px;
    color: var(--text-secondary);
  }

  .missing__other {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--muted);
  }

  h2 {
    font-size: 22px;
  }
</style>
