---
import Icon from './Icon.astro';
import { copy, homePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<section class="cta">
  <div class="container">
    <div class="cta__card">
      <img class="cta__symbol" src="/favicon.svg" alt="" width="96" height="96" />
      <div class="cta__text">
        <h2>{t.cta.title}</h2>
        <p>{t.cta.text}</p>
      </div>
      <a class="button button--primary" href={`${homePath(locale)}#download`}>
        <Icon name="download-simple" size={20} />
        {t.cta.button}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(64px, 9vw, 112px);
  }

  .cta__card {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    background: var(--muted);
  }

  .cta__symbol {
    flex: none;
    width: 96px;
    height: 96px;
  }

  .cta__text {
    flex: 1;
  }

  h2 {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.2;
    font-weight: 800;
  }

  p {
    margin-top: 8px;
    font-size: 18px;
    line-height: 29px;
    color: var(--text-secondary);
  }

  @media (max-width: 760px) {
    .cta__card {
      flex-direction: column;
      text-align: center;
    }

    .cta__card .button {
      width: 100%;
    }
  }
</style>
