---
import Icon from './Icon.astro';
import { copy, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
---

<section class="section local">
  <div class="container local__inner">
    <div class="local__head">
      <h2>{t.local.title}</h2>
      <p>{t.local.text}</p>
    </div>
    <ul class="local__points">
      {
        t.local.points.map((point) => (
          <li>
            <span class="local__icon">
              <Icon name={point.icon} size={24} />
            </span>
            <div>
              <h3>{point.title}</h3>
              <p>{point.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .local {
    background: var(--deep);
    color: #fff;
  }

  .local__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  h2 {
    margin-top: 0;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.2;
    font-weight: 700;
  }

  .local__head > p {
    margin-top: 16px;
    font-size: 18px;
    line-height: 29px;
    color: var(--mist);
  }

  .local__points {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 18px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(231 234 242 / 0.12);
  }

  .local__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--mint);
    color: var(--ink);
  }

  h3 {
    font-size: 18px;
    line-height: 28px;
    font-weight: 700;
  }

  li p {
    margin-top: 4px;
    font-size: 15px;
    line-height: 24px;
    color: var(--mist);
  }

  @media (max-width: 860px) {
    .local__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
