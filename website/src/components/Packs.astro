---
// Free illustration packs (.gafpack) to download and install in Gafira.
// A pack without a URL yet shows as coming soon. The sample illustrations
// are a few of the pack's own, reduced for the web.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { copy, type Locale } from '../i18n/ui';
import { megabytes } from '../lib/release';
import christmas1 from '../assets/packs/christmas-1.webp';
import christmas2 from '../assets/packs/christmas-2.webp';
import christmas3 from '../assets/packs/christmas-3.webp';
import christmas4 from '../assets/packs/christmas-4.webp';
import christmas5 from '../assets/packs/christmas-5.webp';
import ornaments1 from '../assets/packs/ornaments-1.webp';
import ornaments2 from '../assets/packs/ornaments-2.webp';
import ornaments3 from '../assets/packs/ornaments-3.webp';
import ornaments4 from '../assets/packs/ornaments-4.webp';
import ornaments5 from '../assets/packs/ornaments-5.webp';
import occasions1 from '../assets/packs/occasions-1.webp';
import occasions2 from '../assets/packs/occasions-2.webp';
import occasions3 from '../assets/packs/occasions-3.webp';
import occasions4 from '../assets/packs/occasions-4.webp';
import occasions5 from '../assets/packs/occasions-5.webp';
import plants1 from '../assets/packs/plants-1.webp';
import plants2 from '../assets/packs/plants-2.webp';
import plants3 from '../assets/packs/plants-3.webp';
import plants4 from '../assets/packs/plants-4.webp';
import plants5 from '../assets/packs/plants-5.webp';
import flowers1 from '../assets/packs/flowers-1.webp';
import flowers2 from '../assets/packs/flowers-2.webp';
import flowers3 from '../assets/packs/flowers-3.webp';
import flowers4 from '../assets/packs/flowers-4.webp';
import flowers5 from '../assets/packs/flowers-5.webp';
import branches1 from '../assets/packs/branches-1.webp';
import branches2 from '../assets/packs/branches-2.webp';
import branches3 from '../assets/packs/branches-3.webp';
import branches4 from '../assets/packs/branches-4.webp';
import branches5 from '../assets/packs/branches-5.webp';
import fruits1 from '../assets/packs/fruits-1.webp';
import fruits2 from '../assets/packs/fruits-2.webp';
import fruits3 from '../assets/packs/fruits-3.webp';
import fruits4 from '../assets/packs/fruits-4.webp';
import fruits5 from '../assets/packs/fruits-5.webp';

interface Props {
  locale: Locale;
}

interface Pack {
  id: string;
  /** The .gafpack on the CDN; `null` while it is not published. */
  url: string | null;
  size: number | null;
  tint: string;
  images: ImageMetadata[];
}

const { locale } = Astro.props;
const t = copy[locale].packs;

const packs: Pack[] = [
  {
    id: 'christmas',
    url: 'https://cdn.gafira.com/packages/Clip-art-navideno-Free.gafpack',
    size: 30_925_873,
    tint: 'var(--coral)',
    images: [christmas1, christmas2, christmas3, christmas4, christmas5],
  },
  {
    id: 'ornaments',
    url: 'https://cdn.gafira.com/packages/Ornamentos-navidenos-Free.gafpack',
    size: 29_462_725,
    tint: 'var(--mint)',
    images: [ornaments2, ornaments1, ornaments5, ornaments3, ornaments4],
  },
  {
    id: 'occasions',
    url: 'https://cdn.gafira.com/packages/Ornamentos-toda-ocasion-Free.gafpack',
    size: 30_706_871,
    tint: 'var(--text)',
    images: [occasions3, occasions1, occasions2, occasions4, occasions5],
  },
  {
    id: 'plants',
    url: 'https://cdn.gafira.com/packages/plants-leaves-shrubs-Free.gafpack',
    size: 34_839_617,
    tint: 'var(--mint)',
    images: [plants1, plants2, plants3, plants4, plants5],
  },
  {
    id: 'flowers',
    url: 'https://cdn.gafira.com/packages/botanical-flowers-Free.gafpack',
    size: 34_215_653,
    tint: 'var(--coral)',
    images: [flowers1, flowers2, flowers3, flowers4, flowers5],
  },
  {
    id: 'branches',
    url: 'https://cdn.gafira.com/packages/branches-bouquets-arrangements-Free.gafpack',
    size: 53_317_450,
    tint: 'var(--text-secondary)',
    images: [branches1, branches2, branches3, branches4, branches5],
  },
  {
    id: 'fruits',
    url: 'https://cdn.gafira.com/packages/botanical-fruits-Free.gafpack',
    size: 32_007_241,
    tint: 'var(--coral)',
    images: [fruits1, fruits2, fruits3, fruits4, fruits5],
  },
];

// Where each of the five illustrations rests in the stage, in stage widths
// (cqw) and degrees; the first one sits in front, in the centre.
const spots = [
  { x: 0, y: 4, r: 0, s: 1 },
  { x: -30, y: -12, r: -9, s: 0.7 },
  { x: 30, y: -12, r: 9, s: 0.7 },
  { x: -27, y: 22, r: -5, s: 0.62 },
  { x: 27, y: 22, r: 5, s: 0.62 },
];
---

<section class="section packs" id="packs" aria-labelledby="packs-title">
  <div class="container">
    <div class="section-head section-head--center">
      <h2 id="packs-title" class="reveal">{t.title}</h2>
      <p class="reveal" style="--delay:100ms">{t.lead}</p>
    </div>

    <div class="grid">
      {
        packs.map((pack, index) => {
          const item = t.items[index]!;
          return (
            <article
              class:list={['pack', 'reveal', 'reveal--zoom', { 'pack--soon': !pack.url }]}
              style={`--delay:${index * 120}ms;--tint:${pack.tint}`}
              aria-labelledby={`pack-${pack.id}`}
            >
              <div class="stage" role="img" aria-label={item.alt}>
                <span class="badge">{pack.url ? t.free : t.soon}</span>
                {pack.images.map((image, i) => {
                  const spot = spots[i]!;
                  return (
                    <span
                      class="piece"
                      style={`--x:${spot.x}cqw;--y:${spot.y}cqw;--r:${spot.r}deg;--s:${spot.s};--z:${5 - i};--i:${i};--bob:${i * -0.7}s`}
                    >
                      <Image src={image} alt="" widths={[160, 240, 320]} sizes="(max-width: 720px) 40vw, (max-width: 960px) 20vw, 220px" loading="lazy" />
                    </span>
                  );
                })}
              </div>
              <div class="pack__body">
                <h3 id={`pack-${pack.id}`}>{item.name}</h3>
                <p>{item.text}</p>
                <p class="facts">
                  <span>{t.count}</span>
                  <span>.gafpack</span>
                  {pack.size && <span>{megabytes(pack.size)}</span>}
                </p>
                {pack.url ? (
                  <a class="button button--primary get" href={pack.url} download data-pack-download>
                    <span class="get__idle">
                      <Icon name="download-simple" size={20} />
                      {t.download}
                    </span>
                    <span class="get__done" aria-hidden="true">
                      <Icon name="check-circle" size={20} />
                      {t.started}
                    </span>
                  </a>
                ) : (
                  <p class="button get get--soon">
                    <Icon name="hourglass" size={20} />
                    {t.upcoming}
                  </p>
                )}
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="howto reveal">
      <h3>{t.install.title}</h3>
      <ol>
        {
          t.install.steps.map((step, index) => (
            <li>
              <span class="howto__n" aria-hidden="true">
                {index + 1}
              </span>
              <span>
                <strong>{step.title}</strong>
                {step.text}
              </span>
            </li>
          ))
        }
      </ol>
      <p class="license">
        <Icon name="shield-check" size={18} />
        <span>{t.license}</span>
      </p>
    </div>
    <p class="sr-only" aria-live="polite" data-pack-status></p>
  </div>
</section>

<script>
  // Confirms the download on the button for a moment and tells screen readers.
  const status = document.querySelector<HTMLElement>('[data-pack-status]');
  document.querySelectorAll<HTMLAnchorElement>('[data-pack-download]').forEach((link) => {
    let timer = 0;
    link.addEventListener('click', () => {
      link.classList.add('is-started');
      if (status) status.textContent = link.querySelector('.get__done')?.textContent?.trim() ?? '';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => link.classList.remove('is-started'), 2600);
    });
  });
</script>

<style>
  /* Two columns, narrow enough that each stage stays card-sized; three on wide screens (see below). */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 960px;
    margin-inline: auto;
  }

  .pack {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 2px solid var(--muted);
    transition: border-color 220ms var(--ease);
  }

  .pack:hover,
  .pack:focus-within {
    border-color: color-mix(in srgb, var(--tint) 55%, var(--muted));
  }

  /* The stage: five illustrations fanned out, floating; they spread a little
     when the card is pointed at or focused. */
  .stage {
    --k: 1;
    position: relative;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 58%, color-mix(in srgb, var(--tint) 22%, transparent), transparent 62%),
      color-mix(in srgb, var(--tint) 7%, var(--surface));
  }

  .pack:hover .stage,
  .pack:focus-within .stage {
    --k: 1.14;
  }

  /* The one authored moment: until the card is revealed the five pieces sit
     stacked in the centre; then they fan out, one after another. */
  :global(.js) .pack:not(.is-visible) .stage {
    --k: 0;
  }

  :global(.js) .pack:not(.is-visible) .piece {
    --r: 0deg;
  }

  .piece {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: var(--z);
    width: 46%;
    transform: translate(-50%, -50%) translate(calc(var(--x) * var(--k)), calc(var(--y) * var(--k)))
      rotate(var(--r)) scale(var(--s));
    transition: transform 420ms var(--ease);
  }

  :global(.js) .pack .piece {
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--delay, 0ms) + 250ms + var(--i) * 70ms);
  }

  :global(.js) .pack.is-visible:hover .piece,
  :global(.js) .pack.is-visible:focus-within .piece {
    transition-duration: 420ms;
    transition-delay: 0ms;
  }

  .pack:hover .piece:first-of-type,
  .pack:focus-within .piece:first-of-type {
    transform: translate(-50%, -50%) translate(0, 2cqw) scale(1.07);
  }

  .piece :global(img) {
    width: 100%;
    filter: drop-shadow(0 10px 14px rgb(24 36 59 / 0.16));
    animation: bob 5s ease-in-out infinite;
    animation-delay: var(--bob);
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-2.5%) rotate(0.8deg);
    }
  }

  .badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 7;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--mint);
    color: var(--ink);
    font-size: 13px;
    line-height: 22px;
    font-weight: 600;
  }

  .pack--soon .badge {
    background: var(--text);
    color: var(--bg);
  }

  .pack__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 24px 24px 28px;
  }

  h3 {
    font-size: 24px;
    line-height: 32px;
    font-weight: 700;
  }

  .pack__body > p {
    color: var(--text-secondary);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    margin-bottom: 8px;
    font-size: 14px;
    line-height: 22px;
    font-weight: 600;
    color: var(--text);
  }

  .facts span + span::before {
    content: '·';
    margin-right: 8px;
    color: var(--text-secondary);
  }

  .get {
    position: relative;
    margin-top: auto;
    overflow: hidden;
  }

  .get__idle,
  .get__done {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition:
      transform 220ms var(--ease),
      opacity 220ms var(--ease);
  }

  .get__done {
    position: absolute;
    inset: 0;
    justify-content: center;
    opacity: 0;
    transform: translateY(100%);
  }

  .get.is-started {
    background: var(--mint);
    box-shadow: 0 6px 16px rgb(63 191 169 / 0.32);
  }

  .get.is-started .get__idle {
    opacity: 0;
    transform: translateY(-100%);
  }

  .get.is-started .get__done {
    opacity: 1;
    transform: none;
  }

  .get :global(svg) {
    transition: transform 220ms var(--ease);
  }

  .get:hover .get__idle :global(svg) {
    transform: translateY(2px);
  }

  .get--soon {
    border: 2px dashed var(--border);
    color: var(--text-secondary);
    cursor: default;
  }

  .get--soon:hover {
    transform: none;
  }

  .howto {
    display: grid;
    gap: 28px;
    max-width: 960px;
    margin: clamp(56px, 7vw, 80px) auto 0;
  }

  .howto h3 {
    text-align: center;
  }

  .howto ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .howto li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .howto li strong {
    display: block;
    font-family: var(--font-head);
    font-size: 18px;
    line-height: 26px;
  }

  .howto li > span:last-child {
    color: var(--text-secondary);
  }

  .howto li strong {
    color: var(--text);
  }

  .howto__n {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--coral);
    color: var(--ink);
    font-weight: 700;
  }

  .license {
    display: flex;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    line-height: 22px;
    color: var(--text-secondary);
    text-align: center;
  }

  .license :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--mint);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Wide screens: six packs read as two rows of three, using the full container. */
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
    }

    .pack h3 {
      font-size: 22px;
      line-height: 30px;
      text-wrap: balance;
    }

    .howto {
      max-width: none;
    }
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }

  @media (max-width: 960px) {
    .howto ol {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .piece :global(img),
    .piece {
      transition: none;
    }

    .get:hover .get__idle :global(svg) {
      transform: none;
    }
  }
</style>
