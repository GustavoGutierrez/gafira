interface Slide {
  image: ImageMetadata;
  alt: string;
  cover: boolean;
  /** The large file for the viewer. */
  large: string;
}

const cards = await Promise.all(
  packs.map(async (pack, index) => {
    const item = t.items[index]!;
    const sources = [
      { image: pack.cover, alt: item.alt, cover: true },
      ...pack.samples.map((file, i) => ({ image: sample(pack.id, file), alt: item.samples[i]!, cover: false })),
    ];
    const slides: Slide[] = await Promise.all(
      sources.map(async (source) => {
        const large = await getImage({
          src: source.image,
          width: Math.min(source.image.width, 1400),
          format: 'webp',
        });
        return { ...source, large: large.src };
      }),
    );
    const gallery = {
      title: item.name,
      url: pack.url,
      slides: slides.map((slide) => ({ src: slide.large, alt: slide.alt })),
    };
    return { pack, item, slides, gallery };
  }),
);

// Faint illustrations that drift behind the cards: x/y in % of the band,
// size in px, depth (how far they follow the pointer) and a tilt.
const drift = [
  { image: sample('christmas', 'gouache_02_zorro-sueter'), x: 4, y: 12, size: 120, depth: 26, r: -10 },
  { image: sample('occasions', 'cumple-boda_19_arco-boda'), x: 88, y: 8, size: 110, depth: 18, r: 8 },
  { image: sample('ornaments', 'festivos_05_corona-campanas'), x: 92, y: 62, size: 140, depth: 32, r: 6 },
  { image: sample('christmas', 'gouache_07_petirrojo-gorro'), x: 2, y: 70, size: 100, depth: 14, r: 10 },
  { image: sample('occasions', 'cumpleanos_03_cupcake'), x: 20, y: 90, size: 84, depth: 22, r: -6 },
  { image: sample('ornaments', 'hoja-dorada_03_bastones-caramelo'), x: 74, y: 92, size: 90, depth: 12, r: -12 },
  { image: sample('plants', 'hierbas-medicinales_11_pasiflora'), x: 6, y: 40, size: 104, depth: 20, r: 8 },
  { image: sample('plants', 'follajes_07_arbol-de-jade'), x: 91, y: 34, size: 96, depth: 16, r: -8 },
  { image: sample('flowers', 'flores-variadas_05_gloriosa'), x: 4, y: 55, size: 96, depth: 18, r: -8 },
  { image: sample('branches', 'ramas-blancas_04_lirios-blancos'), x: 90, y: 80, size: 100, depth: 24, r: 10 },
