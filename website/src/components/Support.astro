import food1Cover from '../assets/packs/full-world-food-part-1.webp';
import food2Cover from '../assets/packs/full-world-food-part-2.webp';
import foodBundleCover from '../assets/packs/full-world-food-complete.webp';

interface Props {
  locale: Locale;
}

interface FullPack {
  id: string;
  /** The Gumroad product; `null` while it is not on sale, shown as coming soon. */
  url: string | null;
  /** Minimum price in USD on Gumroad, or the fixed price of a bundle. */
  price: number;
  /** A bundle sold at a fixed price instead of "pay what you want". */
  fixed?: boolean;
  count: number;
  /** Illustrations beyond the 30 of the free version. */
  added: number;
  tint: string;
  cover: ImageMetadata;
  /** Sample files in `assets/packs/samples/<id>/`, in the order of their labels in `ui.ts`. */
  samples: string[];
}

const { locale } = Astro.props;
const t = copy[locale].support;

const sampleFiles = import.meta.glob<ImageMetadata>('../assets/packs/samples/*/*.webp', {
  import: 'default',
  eager: true,
});
const sample = (pack: string, file: string): ImageMetadata => {
  const image = sampleFiles[`../assets/packs/samples/${pack}/${file}.webp`];
  if (!image) throw new Error(`Missing pack sample: ${pack}/${file}`);
  return image;
};

